rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isCoach() { return request.auth != null; }
    function isOwnerCoach(coachId) { return isCoach() && request.auth.uid == coachId; }

    // Coaches: fully private to the coach account
    match /coaches/{coachId} {
      allow read, write: if isOwnerCoach(coachId);
    }

    // Clients:
    // - Coaches can read/write their own clients
    // - Query with magicLinkToken for magic-link flow (validated client-side)
    // SECURITY NOTE: Magic link flow allows querying by token. Token validation is client-side only.
    // For improved security, consider implementing proper token-based authentication.
    match /clients/{clientId} {
      allow create: if isCoach();
      allow update, delete: if isOwnerCoach(resource.data.coachId);
      // Allow read if authenticated as coach OR querying with magicLinkToken field (for magic link validation)
      allow read: if isOwnerCoach(resource.data.coachId) || 
                     (request.query.limit == 1);
    }

    // Plans:
    // - Authenticated coaches can read/write their own clients' plans
    // - Unauthenticated access allowed for magic link flow (single document by ID)
    // SECURITY NOTE: This allows anyone with a clientId to read plans. The clientId acts as a shared secret
    // via the magic link. For improved security, implement proper authentication for clients.
    match /workoutPlans/{clientId} {
      allow get: if true; // Single document read by ID (magic link flow)
      allow list: if isCoach(); // Listing requires authentication
      allow write: if isCoach() && isOwnerCoach(request.resource.data.coachId);
    }
    match /dietPlans/{clientId} {
      allow get: if true; // Single document read by ID (magic link flow)
      allow list: if isCoach(); // Listing requires authentication
      allow write: if isCoach() && isOwnerCoach(request.resource.data.coachId);
    }

    // Progress logs:
    // - Athletes can create logs with validation (coachId required for filtering)
    // - Coaches can read logs for their clients
    // - Unauthenticated can list logs for a specific client (magic link flow)
    match /progressLogs/{logId} {
      allow create: if request.resource.data.clientId is string
                    && request.resource.data.coachId is string
                    && request.resource.data.date is string
                    && request.resource.data.weight is string
                    // ensure photos are URLs (not giant base64 strings)
                    && (!(request.resource.data.photoUrl is string) || request.resource.data.photoUrl.matches('^https?://.*'));
      // Allow list queries filtered by clientId (for magic link dashboard)
      allow list: if request.query.limit <= 100;
      // Authenticated coaches can get specific logs
      allow get: if isCoach();
      allow update, delete: if false;
    }
  }
}

